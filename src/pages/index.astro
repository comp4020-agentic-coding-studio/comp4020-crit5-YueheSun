---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dancing Line</title>
    <meta
      name="description"
      content="Dancing Line: a rhythm game where a line dances to the beat and you steer it through the track."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <!--
      No instructions on screen, per the C5 brief: the opening screen is just
      the game, already moving. nav + h1 stay in the markup (invariants.test.ts
      requires both) but are visually hidden via .sr-only.
    -->
    <header class="sr-only">
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
      <h1>Dancing Line</h1>
    </header>
    <main>
      <canvas id="game" aria-label="Dancing Line game"></canvas>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
